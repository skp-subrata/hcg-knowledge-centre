{% extends "base.html" %}

{% block title %}Staff Workspace | HCG Knowledge Centre{% endblock %}

{% block content %}
<div class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-3">HCG knowledge centre</h1>
    <p class="text-slate-500 dark:text-slate-400 text-lg">Manage content, assessments, assignments, and users.</p>
</div>

<div class="flex flex-wrap gap-2 mb-8 bg-slate-100/50 dark:bg-slate-900/30 p-1.5 rounded-2xl border border-slate-200/50 dark:border-slate-800/40 w-fit">
    <a href="#creation-tools" class="px-4 py-2 text-xs font-bold rounded-xl text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:shadow-sm transition">
        Creation Tools
    </a>
    <a href="#courses-section" class="px-4 py-2 text-xs font-bold rounded-xl text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:shadow-sm transition">
        Courses List
    </a>
    <a href="#users-section" class="px-4 py-2 text-xs font-bold rounded-xl text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:shadow-sm transition">
        Users Directory
    </a>
    {% if role == 'admin' %}
    <a href="#api-creds-section" class="px-4 py-2 text-xs font-bold rounded-xl text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:shadow-sm transition">
        API Developer Access
    </a>
    {% endif %}
    <a href="/admin/reports" class="px-4 py-2 text-xs font-bold rounded-xl bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 hover:shadow-sm transition border border-indigo-100 dark:border-indigo-800/50">
        Reporting & Analytics
    </a>
</div>

<section class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-6 mb-12" id="creation-tools">
    <!-- Create Course -->
    <form class="glass-panel p-6 flex flex-col" method="post" enctype="multipart/form-data">
        <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 mb-5 border-b border-slate-200 dark:border-slate-800 pb-3">Create course</h2>
        <input type="hidden" name="action" value="add_course">
        
        <div class="space-y-4 flex-grow">
            <div>
                <label class="form-label">Course name</label>
                <input name="course_name" class="form-input" required>
            </div>
            <div>
                <label class="form-label">Description</label>
                <input name="description" class="form-input">
            </div>
            <div>
                <label class="form-label">Category</label>
                <input name="category" class="form-input" placeholder="General">
            </div>
            <div>
                <label class="form-label">Content type</label>
                <select name="content_type" class="form-input">
                    {% for item in content_types %}
                    <option>{{ item }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label class="form-label">Content URL or file</label>
                <input name="content_url" type="url" class="form-input mb-2" placeholder="https://...">
                <input name="course_file" type="file" class="form-input text-sm" accept=".pdf,.mp4,.webm,.mov,.avi,.mkv,.ppt,.pptx">
            </div>
        </div>
        
        <button class="btn-primary w-full mt-6 flex justify-center py-3.5" title="Create Course"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg></button>
    </form>

    <div class="space-y-6 flex flex-col">
        <!-- Assign Course -->
        <form class="glass-panel p-6" method="post">
            <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 mb-5 border-b border-slate-200 dark:border-slate-800 pb-3">Assign course</h2>
            <input type="hidden" name="action" value="assign_course">
            <div class="space-y-4">
                <div>
                    <label class="form-label">Course</label>
                    <select name="course_id" class="form-input" required>
                        <option value="" disabled selected>Select a Course</option>
                        {% for item in assignable_courses %}
                        <option value="{{ item.id }}">#{{ item.id }} - {{ item.name }}</option>
                        {% else %}
                        <option disabled>No eligible courses</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
    <label class="form-label">Assign To</label>
    <div class="flex items-center gap-4 mb-2">
        <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300"><input type="radio" name="assignment_type" value="individual" checked onchange="document.getElementById('student_select').style.display='block'; document.getElementById('group_select').style.display='none'; document.getElementById('student_id_input').required=true; document.getElementById('group_id_input').required=false;"> Individual</label>
        <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300"><input type="radio" name="assignment_type" value="group" onchange="document.getElementById('student_select').style.display='none'; document.getElementById('group_select').style.display='block'; document.getElementById('student_id_input').required=false; document.getElementById('group_id_input').required=true;"> Group</label>
    </div>
</div>
<div id="student_select">
    <label class="form-label">Student</label>
    <select name="student_id" id="student_id_input" class="form-input" required>
        {% for item in students %}
        <option value="{{ item.id }}">{{ item.full_name }}</option>
        {% else %}
        <option disabled>No students</option>
        {% endfor %}
    </select>
</div>
<div id="group_select" style="display: none;">
    <label class="form-label">Group</label>
    <select name="group_id" id="group_id_input" class="form-input">
        <option value="" disabled selected>Select Group</option>
        {% for item in groups %}
        <option value="{{ item.id }}">{{ item.name }}</option>
        {% else %}
        <option disabled>No groups</option>
        {% endfor %}
    </select>
</div>
            </div>
            <button class="btn-primary w-full mt-6 flex justify-center py-3.5" title="Assign Course"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg></button>
        </form>
    </div>
</section>
<!-- Additional Forms Section -->
<section class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-6 mb-12">
    <!-- Add Assessment -->
    <form class="glass-panel p-6" method="post">
        <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 mb-5 border-b border-slate-200 dark:border-slate-800 pb-3">Create Assessment</h2>
        <input type="hidden" name="action" value="add_assessment">
        <div class="space-y-4">
            <div>
                <label class="form-label">Course</label>
                <select name="course_id" class="form-input">
                    {% for item in courses %}
                    <option value="{{ item.id }}">{{ item.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label class="form-label">Title</label>
                <input name="assessment_title" class="form-input" required>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Type</label>
                    <select name="assessment_type" class="form-input">
                        <option value="pre">Pre-assessment</option>
                        <option value="post">Post-assessment</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Pass %</label>
                    <input name="pass_percentage" type="number" min="1" max="100" value="60" class="form-input">
                </div>
            </div>
        </div>
        <button class="btn-primary w-full mt-6 flex justify-center py-3.5" title="Create Assessment"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></button>
    </form>

    
    <!-- Manual Question Add -->
    <form class="glass-panel p-6 flex flex-col" method="post">
        <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 mb-5 border-b border-slate-200 dark:border-slate-800 pb-3">Add Question</h2>
        <input type="hidden" name="action" value="add_question">
        <div class="space-y-4 flex-grow">
            <div>
                <label class="form-label">Assessment</label>
                <select name="assessment_id" class="form-input" required>
                    {% for item in assessments %}
                    <option value="{{ item.id }}">{{ item.title }} ({{ item.course_name }})</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label class="form-label">Question Text</label>
                <input name="question_text" class="form-input" required>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div><label class="form-label text-xs">Option A</label><input name="option_a" class="form-input" required></div>
                <div><label class="form-label text-xs">Option B</label><input name="option_b" class="form-input" required></div>
                <div><label class="form-label text-xs">Option C</label><input name="option_c" class="form-input" required></div>
                <div><label class="form-label text-xs">Option D</label><input name="option_d" class="form-input" required></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Correct</label>
                    <select name="correct_option" class="form-input" required>
                        <option value="a">A</option><option value="b">B</option>
                        <option value="c">C</option><option value="d">D</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Marks</label>
                    <input name="marks" type="number" value="1" min="1" class="form-input">
                </div>
            </div>
        </div>
        <button class="btn-primary w-full mt-6 flex justify-center py-3.5" title="Add Question"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg></button>
    </form>

    <!-- Excel Question Import -->
    <form class="glass-panel p-6" method="post" enctype="multipart/form-data">
        <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 mb-5 border-b border-slate-200 dark:border-slate-800 pb-3">Import questions</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Use course ID to connect every question to its assessment.</p>
        <input type="hidden" name="action" value="import_questions">
        <a href="{{ url_for('download_question_template') }}" class="text-slate-900 dark:text-slate-100 font-medium font-semibold hover:underline">Download Excel template</a>
        <div class="mt-5"><label class="form-label">Completed .xlsx file</label><input name="question_file" type="file" accept=".xlsx" class="form-input" required></div>
        <button class="btn-primary w-full mt-6 flex justify-center py-3.5" title="Upload Questions"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg></button>
    </form>

    {% if role == 'admin' %}
    <!-- Add User -->
    <form class="glass-panel p-6" method="post">
        <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 mb-5 border-b border-slate-200 dark:border-slate-800 pb-3">Add User</h2>
        <input type="hidden" name="action" value="add_user">
        <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Full name</label>
                    <input name="full_name" class="form-input" required>
                </div>
                <div>
                    <label class="form-label">Username</label>
                    <input name="username" class="form-input" required>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Password</label>
                    <input name="password" type="password" minlength="6" class="form-input" required>
                </div>
                <div>
                    <label class="form-label">Role</label>
                    <select name="role" class="form-input">
                        {% for item in roles %}
                        <option value="{{ item }}">{{ item|title }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
        <button class="btn-primary w-full mt-6 flex justify-center py-3.5" title="Add User"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg></button>
    </form>

    {% endif %}
</section>

<!-- Tables Section -->
<div class="space-y-8">

    <!-- ═══ COURSES TABLE ═══ -->
    <section class="glass-panel p-6 overflow-hidden" id="courses-section">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
            <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">Courses</h2>
            <div class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center">
                <!-- Search -->
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
                    <input id="courseSearch" type="text" placeholder="Search name, category…" class="form-input pl-9 h-9 text-sm w-full sm:w-56" oninput="filterTable('courses-tbody','courseSearch',['courseFilterBtns'])">
                </div>
                <!-- Filter chips -->
                <div class="flex gap-1.5 flex-wrap" id="courseFilterBtns">
                    <button class="adm-chip active" data-col="4" data-val="">All</button>
                    <button class="adm-chip" data-col="4" data-val="published">Published</button>
                    <button class="adm-chip" data-col="4" data-val="draft">Draft</button>
                    <button class="adm-chip" data-col="3" data-val="URL">URL</button>
                    <button class="adm-chip" data-col="3" data-val="Video">Video</button>
                    <button class="adm-chip" data-col="3" data-val="PDF">PDF</button>
                    <button class="adm-chip" data-col="3" data-val="PPT">PPT</button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800">
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">ID</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Course Name</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Category</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Type</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Status</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="courses-tbody" class="divide-y divide-slate-100 dark:divide-slate-800">
                    {% for item in courses %}
                    <tr class="hover:bg-white/30 dark:hover:bg-white/5 transition course-row"
                        data-search="{{ item.id }} {{ item.name|lower }} {{ (item.category or 'general')|lower }} {{ item.content_type|lower }} {{ (item.status or 'published')|lower }}">
                        <td class="p-3 font-bold text-slate-500 font-medium">#{{ item.id }}</td>
                        <td class="p-3 font-semibold">{{ item.name }}</td>
                        <td class="p-3 text-slate-500 dark:text-slate-400">{{ item.category or 'General' }}</td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded-full bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400 text-[10px] font-bold uppercase tracking-wider">{{ item.content_type }}</span>
                        </td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider
                                {% if item.status == 'draft' %}bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400
                                {% else %}bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400{% endif %}">
                                {{ item.status or 'published' }}
                            </span>
                        </td>
                        <td class="p-3 text-right space-y-1">
                            <form method="post" action="{{ url_for('delete_record', resource='course', record_id=item.id) }}" onsubmit="return confirm('Delete this course?')" class="inline">
                                <button type="submit" class="text-xs text-red-500 font-semibold hover:underline">Delete</button>
                            </form>
                            <form method="post" class="flex gap-1 justify-end flex-wrap mt-1">
                                <input type="hidden" name="action" value="update_course">
                                <input type="hidden" name="record_id" value="{{ item.id }}">
                                <input name="name" value="{{ item.name }}" class="form-input h-8 w-32 text-xs" required>
                                <input name="category" value="{{ item.category or 'General' }}" class="form-input h-8 w-24 text-xs">
                                <select name="status" class="form-input h-8 w-24 text-xs">
                                    <option {% if item.status == 'published' %}selected{% endif %}>published</option>
                                    <option {% if item.status == 'draft' %}selected{% endif %}>draft</option>
                                </select>
                                <button type="submit" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline px-2">Update</button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="p-8 text-center text-slate-400 text-sm">No courses yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p id="courses-empty" class="hidden text-center text-slate-400 text-sm py-6">No courses match your search or filter.</p>
    </section>

    <!-- ═══ USERS TABLE ═══ -->
    <section class="glass-panel p-6 overflow-hidden" id="users-section">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
            <h2 id="users" class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 pt-8 -mt-8">Users</h2>
            <div class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center">
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
                    <input id="userSearch" type="text" placeholder="Search name, username…" class="form-input pl-9 h-9 text-sm w-full sm:w-56" oninput="filterTable('users-tbody','userSearch',['userFilterBtns'])">
                </div>
                <div class="flex gap-1.5 flex-wrap" id="userFilterBtns">
                    <button class="adm-chip active" data-col="3" data-val="">All Roles</button>
                    <button class="adm-chip" data-col="3" data-val="admin">Admin</button>
                    <button class="adm-chip" data-col="3" data-val="moderator">Moderator</button>
                    <button class="adm-chip" data-col="3" data-val="basic user">Student</button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800">
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Name</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Username</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Course IDs</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Role</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="users-tbody" class="divide-y divide-slate-100 dark:divide-slate-800">
                    {% for item in users %}
                    <tr class="hover:bg-white/30 dark:hover:bg-white/5 transition user-row"
                        data-search="{{ item.full_name|lower }} {{ item.username|lower }} {{ item.role|lower }} {{ item.course_ids or '' }}">
                        <td class="p-3 font-semibold">{{ item.full_name }}</td>
                        <td class="p-3 text-slate-500 dark:text-slate-400 text-sm">{{ item.username }}</td>
                        <td class="p-3 text-slate-500 dark:text-slate-400 text-sm">{{ item.course_ids or '—' }}</td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider
                                {% if item.role == 'admin' %}bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-400
                                {% elif item.role == 'moderator' %}bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400
                                {% else %}bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300{% endif %}">
                                {{ item.role }}
                            </span>
                        </td>
                        <td class="p-3 text-right space-y-1">
                            {% if role == 'admin' %}
                            <div class="flex gap-2 justify-end">
                                <form method="post" action="{{ url_for('view_as', user_id=item.id) }}" class="inline">
                                    <button type="submit" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline">Preview as</button>
                                </form>
                                <form method="post" action="{{ url_for('delete_record', resource='user', record_id=item.id) }}" class="inline" onsubmit="return confirm('Delete this user?')">
                                    <button type="submit" class="text-xs font-semibold text-red-500 hover:underline">Delete</button>
                                </form>
                            </div>
                            <form method="post" class="flex gap-1 justify-end flex-wrap mt-1">
                                <input type="hidden" name="action" value="update_user">
                                <input type="hidden" name="record_id" value="{{ item.id }}">
                                <input name="full_name" value="{{ item.full_name }}" class="form-input h-8 w-32 text-xs" required>
                                <input name="username" value="{{ item.username }}" class="form-input h-8 w-32 text-xs" required>
                                <select name="role" class="form-input h-8 w-28 text-xs">
                                    {% for option in roles %}<option value="{{ option }}" {% if option == item.role %}selected{% endif %}>{{ option }}</option>{% endfor %}
                                </select>
                                <button type="submit" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline px-2">Update</button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p id="users-empty" class="hidden text-center text-slate-400 text-sm py-6">No users match your search or filter.</p>
    </section>

    <!-- ═══ API CREDENTIALS TABLE ═══ -->
    {% if role == 'admin' %}
    <section class="glass-panel p-6 overflow-hidden" id="api-creds-section">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5 border-b border-slate-200 dark:border-slate-800 pb-4">
            <div>
                <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">API Developer Access</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Manage developers' API credentials, view doc site and launch playground.</p>
            </div>
            <div class="flex gap-3">
                <a href="/api/v1/docs" class="btn-secondary text-xs px-4 py-2 rounded-xl flex items-center gap-1.5 font-semibold">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    API Docs & Playground
                </a>
            </div>
        </div>

        <!-- Generate Creds Form -->
        <form class="flex flex-col sm:flex-row gap-4 items-end mb-8 bg-slate-50 dark:bg-slate-900/40 p-4 rounded-2xl border border-slate-100 dark:border-slate-800" method="post">
            <input type="hidden" name="action" value="generate_api_creds">
            <div class="flex-grow max-w-sm">
                <label class="form-label">Select User for API Key</label>
                <select name="target_user_id" class="form-input text-sm" required>
                    {% for item in users %}
                    <option value="{{ item.id }}">{{ item.full_name }} ({{ item.username }} - {{ item.role|title }})</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="btn-primary px-5 py-2.5 rounded-xl font-bold text-xs shadow-md">
                Generate API Key & Secret
            </button>
        </form>

        <!-- Credentials List Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800">
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">User</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Role</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">API Key</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">API Secret</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Status</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                    {% for item in api_creds %}
                    <tr class="hover:bg-white/30 dark:hover:bg-white/5 transition">
                        <td class="p-3 font-semibold">
                            <span class="block text-slate-900 dark:text-slate-50">{{ item.full_name }}</span>
                            <span class="text-xs text-slate-400 font-medium">@{{ item.username }}</span>
                        </td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider
                                {% if item.role == 'admin' %}bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-400
                                {% elif item.role == 'moderator' %}bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400
                                {% else %}bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300{% endif %}">
                                {{ item.role|title }}
                            </span>
                        </td>
                        <td class="p-3">
                            <div class="flex items-center gap-2 group">
                                <span class="font-mono text-xs text-slate-700 dark:text-slate-300">{{ item.api_key }}</span>
                                <button type="button" onclick="navigator.clipboard.writeText('{{ item.api_key }}'); this.innerHTML='<svg class=\'w-3.5 h-3.5 text-green-500\' fill=\'none\' viewBox=\'0 0 24 24\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M5 13l4 4L19 7\'></path></svg>'; setTimeout(() => { this.innerHTML='<svg class=\'w-3.5 h-3.5\' fill=\'none\' viewBox=\'0 0 24 24\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z\'></path></svg>' }, 2000);" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition opacity-0 group-hover:opacity-100 focus:opacity-100" title="Copy API Key">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                </button>
                            </div>
                        </td>
                        <td class="p-3">
                            {% if item.status == 'active' %}
                            <div class="flex items-center gap-2 group">
                                <span class="font-mono text-xs text-slate-700 dark:text-slate-300" id="secret-{{ item.id }}" data-secret="{{ item.api_secret }}">••••••••••••••••</span>
                                
                                <!-- Eye Toggle Button -->
                                <button type="button" onclick="const el=document.getElementById('secret-{{ item.id }}'); if(el.innerText==='••••••••••••••••'){el.innerText=el.dataset.secret;}else{el.innerText='••••••••••••••••';}" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition opacity-0 group-hover:opacity-100 focus:opacity-100" title="Toggle Visibility">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                </button>
                                
                                <!-- Copy Button -->
                                <button type="button" onclick="navigator.clipboard.writeText('{{ item.api_secret }}'); this.innerHTML='<svg class=\'w-3.5 h-3.5 text-green-500\' fill=\'none\' viewBox=\'0 0 24 24\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M5 13l4 4L19 7\'></path></svg>'; setTimeout(() => { this.innerHTML='<svg class=\'w-3.5 h-3.5\' fill=\'none\' viewBox=\'0 0 24 24\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z\'></path></svg>' }, 2000);" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition opacity-0 group-hover:opacity-100 focus:opacity-100" title="Copy API Secret">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                </button>
                            </div>
                            {% else %}
                            <span class="font-mono text-xs text-slate-400 line-through">{{ item.api_secret[:8] }}...</span>
                            {% endif %}
                        </td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider
                                {% if item.status == 'active' %}bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400
                                {% else %}bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400{% endif %}">
                                {{ item.status }}
                            </span>
                        </td>
                        <td class="p-3 text-right space-x-2">
                            {% if item.status == 'active' %}
                            <a href="/admin/api-credentials/{{ item.user_id }}/download" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">Download JSON</a>
                            <form class="inline" method="post" onsubmit="return confirm('Revoke credentials for @{{ item.username }}?')">
                                <input type="hidden" name="action" value="revoke_api_creds">
                                <input type="hidden" name="target_user_id" value="{{ item.user_id }}">
                                <button type="submit" class="text-xs font-semibold text-red-500 hover:underline">Revoke</button>
                            </form>
                            {% else %}
                            <span class="text-xs text-slate-400 italic">Revoked</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="p-8 text-center text-slate-400 text-sm">No API keys generated yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    {% endif %}

    <!-- ═══ ASSESSMENTS TABLE ═══ -->
    <section class="glass-panel p-6 overflow-hidden" id="assessments-section">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
            <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">Assessments</h2>
            <div class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center">
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
                    <input id="assessSearch" type="text" placeholder="Search title, course…" class="form-input pl-9 h-9 text-sm w-full sm:w-56" oninput="filterTable('assess-tbody','assessSearch',['assessFilterBtns'])">
                </div>
                <div class="flex gap-1.5 flex-wrap" id="assessFilterBtns">
                    <button class="adm-chip active" data-col="3" data-val="">All Types</button>
                    <button class="adm-chip" data-col="3" data-val="pre">Pre-assessment</button>
                    <button class="adm-chip" data-col="3" data-val="post">Post-assessment</button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-800">
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">ID</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Assessment Title</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Course</th>
                        <th class="p-3 font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Type</th>
                        <th class="p-3 text-right font-bold text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody id="assess-tbody" class="divide-y divide-slate-100 dark:divide-slate-800">
                    {% for item in assessments %}
                    <tr class="hover:bg-white/30 dark:hover:bg-white/5 transition assess-row"
                        data-search="#{{ item.id }} {{ item.title|lower }} {{ item.course_name|lower }} {{ item.type|lower }}">
                        <td class="p-3 font-bold text-slate-500 font-medium">#{{ item.id }}</td>
                        <td class="p-3 font-semibold">{{ item.title }}</td>
                        <td class="p-3 text-slate-500 dark:text-slate-400 text-sm">{{ item.course_name }}</td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider
                                {% if item.type == 'pre' %}bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400
                                {% else %}bg-teal-100 text-teal-700 dark:bg-teal-900/30 dark:text-teal-400{% endif %}">
                                {{ 'Pre' if item.type == 'pre' else 'Post' }}
                            </span>
                        </td>
                        <td class="p-3 text-right space-y-1">
                            <div class="flex gap-2 justify-end">
                                <a href="{{ url_for('download_assessment_questions', assessment_id=item.id) }}" class="text-xs font-semibold text-slate-600 dark:text-slate-300 hover:underline">CSV</a>
                                <form class="inline" method="post" action="{{ url_for('delete_record', resource='assessment', record_id=item.id) }}" onsubmit="return confirm('Delete this assessment?')">
                                    <button type="submit" class="text-xs font-semibold text-red-500 hover:underline">Delete</button>
                                </form>
                            </div>
                            <form class="mt-1 flex gap-1 justify-end flex-wrap" method="post">
                                <input type="hidden" name="action" value="update_assessment">
                                <input type="hidden" name="record_id" value="{{ item.id }}">
                                <input type="hidden" name="type" value="{{ item.type }}">
                                <input type="hidden" name="max_attempts" value="{{ item.max_attempts }}">
                                <input class="form-input h-8 w-36 text-xs" name="title" value="{{ item.title }}" required>
                                <input class="form-input h-8 w-20 text-xs" name="pass_percentage" type="number" value="{{ item.pass_percentage }}" min="1" max="100" title="Pass %">
                                <button class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline px-2" type="submit">Update</button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="p-8 text-center text-slate-400 text-sm">No assessments yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p id="assess-empty" class="hidden text-center text-slate-400 text-sm py-6">No assessments match your search or filter.</p>
    </section>
</div>

<style>
.adm-chip {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    border: 1.5px solid #e2e8f0;
    color: #64748b;
    cursor: pointer;
    transition: all .15s;
    white-space: nowrap;
}
.dark .adm-chip { border-color: #334155; color: #94a3b8; }
.adm-chip:hover { border-color: #818cf8; color: #6366f1; }
.adm-chip.active { background: #6366f1; border-color: #6366f1; color: #fff; }
</style>

<script>
// ── Generic search + chip filter for any table ──────────────────────────────
// activeFilters[tbodyId] = { col, val }
const activeFilters = {};

function filterTable(tbodyId, searchId, chipGroupIds) {
    const tbody    = document.getElementById(tbodyId);
    const search   = document.getElementById(searchId)?.value.toLowerCase().trim() || '';
    const filter   = activeFilters[tbodyId] || { col: null, val: '' };
    const rows     = tbody.querySelectorAll('tr[data-search]');
    const emptyMsg = document.getElementById(tbodyId.replace('-tbody','') + '-empty')
                  || document.getElementById(tbodyId.replace('tbody','empty'));
    let visible = 0;

    rows.forEach(row => {
        const text   = row.dataset.search || '';
        const cells  = row.querySelectorAll('td');
        const colVal = filter.col !== null && cells[filter.col]
                       ? cells[filter.col].textContent.toLowerCase().trim()
                       : '';
        const matchSearch = !search || text.includes(search);
        const matchFilter = !filter.val || colVal.includes(filter.val.toLowerCase());
        const show = matchSearch && matchFilter;
        row.classList.toggle('hidden', !show);
        if (show) visible++;
    });

    if (emptyMsg) emptyMsg.classList.toggle('hidden', visible > 0 || rows.length === 0);
}

// Wire up chip buttons
document.querySelectorAll('.adm-chip').forEach(chip => {
    chip.addEventListener('click', () => {
        // Find the sibling group
        const group = chip.closest('[id$="FilterBtns"]');
        if (!group) return;
        group.querySelectorAll('.adm-chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');

        // Find which table this group belongs to
        const section = group.closest('section');
        const tbody   = section.querySelector('tbody[id]');
        const searchEl = section.querySelector('input[type="text"]');
        if (!tbody) return;

        activeFilters[tbody.id] = { col: parseInt(chip.dataset.col), val: chip.dataset.val };
        filterTable(tbody.id, searchEl?.id, []);
    });
});
</script>
{% endblock %}
